# Cloudflare Pages yanıt başlıkları. GitHub Pages bu dosyayı kullanmaz.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Web sürümünün paket parçaları içerik özetli adlar taşır; değişince adı da değişir.
/uygulama/js/*
  Cache-Control: public, max-age=31536000, immutable

# Servis çalışanı her açılışta denetlenir; yeni sürüm gecikmeden gelir.
/uygulama/sw.js
  Cache-Control: no-cache
